# Copie este arquivo para ".env" (uso local) e preencha com seus valores reais.
# Em produção (Render), configure as mesmas variáveis em Settings > Environment.

# Banco de dados Postgres (Render fornece isso automaticamente ao criar o banco)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# IA usada para ler os prints dos baús e da lista de membros
ANTHROPIC_API_KEY=sua_chave_aqui

# Login do painel administrativo do site
ADMIN_PASSWORD=escolha_uma_senha_forte

# Chave própria usada pelo robô de coleta automática (PC e celular),
# separada da senha de admin acima
AUTOMATION_API_KEY=escolha_outra_senha_forte

# Nome do clã, exibido no topo do site
CLAN_NAME=Nome do Clã

# Chave de sessão do Flask (qualquer string aleatória longa)
SECRET_KEY=uma_string_aleatoria_qualquer

# Opcional: notificação no Telegram quando um baú raro/épico/lendário é coletado
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=5000
