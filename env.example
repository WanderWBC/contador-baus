# Copie este arquivo para ".env" e preencha com seus valores reais.
ANTHROPIC_API_KEY=sua_chave_aqui
ADMIN_PASSWORD=escolha_uma_senha_forte
SECRET_KEY=uma_string_aleatoria_qualquer
# Copie este arquivo para ".env" e preencha com seus valores reais.
ANTHROPIC_API_KEY=sua_chave_aqui
ADMIN_PASSWORD=escolha_uma_senha_forte
SECRET_KEY=uma_string_aleatoria_qualquer
PORT=5000

# String de conexão do banco Postgres (pegue no Neon - veja MANUAL.md, seção "Banco de dados")
DATABASE_URL=postgresql://usuario:senha@endereco.neon.tech/nomedobanco?sslmode=require

# Nome do clã exibido no topo do site (cada clã tem sua própria cópia do app,
# então cada cópia tem o seu próprio nome aqui)
CLAN_NAME=BRA Brasil 3

# Opcional: notificação automática no Telegram quando um baú raro/épico/heroico
# é lançado. Deixe em branco se não quiser usar essa função.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
